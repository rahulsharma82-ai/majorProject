<% layout("/layouts/boilerplate") %>

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .signup-page {
        min-height: calc(100vh - 70px);
        width: 100%;

        display: flex;
        justify-content: center;
        align-items: center;

        padding: 40px 6%;

        background: linear-gradient(
            135deg,
            #08a9df,
            #0588c5
        );
    }

    /* Main Signup Box */
    .signup-box {
        width: 100%;
        max-width: 1050px;
        min-height: 600px;

        display: flex;

        background: white;

        border-radius: 25px;

        overflow: hidden;

        box-shadow:
            0 25px 60px rgba(0, 0, 0, 0.25);
    }

    /* Left Travel Image */
    .signup-image {
        width: 50%;
        min-height: 600px;

        position: relative;

        background-image:
            linear-gradient(
                rgba(0, 80, 130, 0.15),
                rgba(0, 40, 80, 0.25)
            ),
            url("/images/signup.jpg");

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;

        display: flex;
        align-items: flex-start;
        justify-content: center;

        padding: 45px 30px;
    }

    .travel-content {
        text-align: center;
        color: white;

        text-shadow:
            0 3px 10px rgba(0, 0, 0, 0.4);
    }

    .travel-content h1 {
        margin: 0;

        font-size: 42px;
        font-weight: 800;

        font-family: Georgia, serif;
        font-style: italic;
    }

    .travel-content p {
        margin-top: 8px;

        font-size: 15px;
        font-weight: 500;
    }

    /* Right Form */
    .signup-form {
        width: 50%;

        padding: 50px 70px;

        display: flex;
        flex-direction: column;
        justify-content: center;

        background: rgba(255, 255, 255, 0.98);
    }

    .signup-form h2 {
        margin: 0;

        text-align: center;

        color: #079ed7;

        font-size: 38px;
        font-weight: 800;
    }

    .signup-subtitle {
        text-align: center;

        color: #888;

        font-size: 14px;

        margin: 5px 0 30px;
    }

    /* Input */
    .signup-input {
        margin-bottom: 18px;
    }

    .signup-input label {
        display: block;

        margin-bottom: 6px;

        color: #333;

        font-size: 13px;
        font-weight: 600;
    }

    .signup-input input {
        width: 100%;
        height: 45px;

        padding: 0 15px;

        border: 1px solid #d8d8d8;

        border-radius: 8px;

        outline: none;

        font-size: 14px;

        transition: 0.3s;
    }

    .signup-input input:focus {
        border-color: #08a9df;

        box-shadow:
            0 0 0 3px rgba(8, 169, 223, 0.12);
    }

    /* Signup Button */
    .signup-btn {
        width: 100%;
        height: 45px;

        margin-top: 5px;

        border: none;
        border-radius: 8px;

        background: linear-gradient(
            90deg,
            #08a9df,
            #007ac2
        );

        color: white;

        font-size: 15px;
        font-weight: 600;

        cursor: pointer;

        transition: 0.3s;
    }

    .signup-btn:hover {
        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(0, 130, 200, 0.3);
    }

    /* Login Link */
    .login-link {
        text-align: center;

        margin-top: 22px;

        color: #777;

        font-size: 13px;
    }

    .login-link a {
        color: #079ed7;

        font-weight: 700;

        text-decoration: none;
    }

    .login-link a:hover {
        text-decoration: underline;
    }

    /* Mobile */
    @media (max-width: 768px) {

        .signup-page {
            padding: 25px 15px;
        }

        .signup-box {
            flex-direction: column;

            max-width: 500px;
        }

        .signup-image {
            width: 100%;
            min-height: 230px;

            padding: 35px 20px;

            background-position: center;
        }

        .travel-content h1 {
            font-size: 32px;
        }

        .signup-form {
            width: 100%;

            padding: 35px 25px;
        }

        .signup-form h2 {
            font-size: 32px;
        }
    }
</style>


<div class="signup-page">

    <div class="signup-box">

        <!-- LEFT SIDE -->
        <div class="signup-image">

            <div class="travel-content">

                <h1>Wanderlust</h1>

                <p>
                    Explore the world. Create unforgettable memories.
                </p>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="signup-form">

            <h2>Welcome</h2>

            <div class="signup-subtitle">
                Create your Wanderlust account
            </div>


            <form
                action="/signup"
                method="POST"
                class="needs-validation"
                novalidate
            >

                <!-- Username -->
                <div class="signup-input">

                    <label for="username">
                        Username
                    </label>

                    <input
                        type="text"
                        name="username"
                        id="username"
                        placeholder="Enter Username"
                        required
                    >

                    <div class="valid-feedback">
                        Looks good!
                    </div>

                </div>


                <!-- Email -->
                <div class="signup-input">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        id="email"
                        placeholder="Enter Email"
                        required
                    >

                </div>
                <!-- Password -->
                <div class="signup-input">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        placeholder="Enter Password"
                        required
                    >

                </div>


                <!-- Button -->
                <button
                    type="submit"
                    class="signup-btn"
                >
                    Create Account
                </button>

            </form>


            <!-- Login -->
            <div class="login-link">

                Already have an account?

                <a href="/login">
                    Login
                </a>

            </div>

        </div>

    </div>

</div>