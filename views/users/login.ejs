<% layout("/layouts/boilerplate") %>  
  
<style>  
    * {  
        box-sizing: border-box;  
    }  
  
    html, 
    body {  
        margin: 0;  
        padding: 0; 
        width: 100%; 
    }  
  
    .login-page {  
        min-height: calc(100vh - 70px); 
        width: 100%;  
  
        display: flex;  
        justify-content: flex-end;  
        align-items: center;  
  
        padding: 60px 8%;  
  
        position: relative;  
        overflow: hidden;  
  
        background-image:  
            linear-gradient(  
                90deg,  
                rgba(15, 30, 60, 0.15),  
                rgba(15, 20, 60, 0.35)  
            ),  
            url("/images/travel-login.jpg");  
  
        /* IMPORTANT: full image show */ 
        background-size: 100% 180%; 
        background-position: center center; 
        background-repeat: no-repeat; 
    }  

    /* Dark overlay */  
    .login-page::before {  
        content: "";  
        position: absolute;  
        inset: 0;  
  
        background: linear-gradient(  
            90deg,  
            rgba(0, 0, 0, 0.05),  
            rgba(20, 20, 70, 0.25)  
        );  
  
        z-index: 1;  
    }  
  
    /* Login Card */  
    .login-card {  
        width: 390px;  
        padding: 45px 32px 30px;  
  
        position: relative;  
        z-index: 2;  
  
        border-radius: 20px;  
  
        background: rgba(255, 255, 255, 0.22);  
  
        border: 1px solid rgba(255, 255, 255, 0.55);  
  
        backdrop-filter: blur(15px);  
        -webkit-backdrop-filter: blur(15px);  
  
        box-shadow:  
            0 20px 50px rgba(0, 0, 0, 0.25),  
            inset 0 1px 10px rgba(255, 255, 255, 0.3); 
    }  
  
    /* Welcome */  
    .login-card h1 {  
        margin: 0 0 8px;  
        text-align: center;  
        color: white;  
        font-size: 40px;  
        font-weight: 800;  
        letter-spacing: 2px;  
        text-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);  
    }  
  
    .login-card h2 {  
        margin: 0 0 28px;  
        text-align: center;  
        color: white;  
        font-size: 24px;  
        font-weight: 400;  
    }  
  
    /* Input */  
    .login-input {  
        display: flex;  
        align-items: center;  
        height: 45px;  
        margin-bottom: 14px;  
        padding: 0 12px;  
        border-radius: 8px;  
        background: rgba(255, 255, 255, 0.8);  
        border: 1px solid rgba(255, 255, 255, 0.7);  
    }  
  
    .login-input span {  
        width: 30px;  
        font-size: 17px;  
        color: #353477;  
    }  
  
    .login-input input {  
        width: 100%;  
        height: 100%;  
        border: none;  
        outline: none;  
        background: transparent;  
        color: #333;  
        font-size: 14px;  
    }  
  
    .login-input input::placeholder {  
        color: #777;  
    }  
  
    /* Remember */  
    .remember {  
        margin: 8px 0 22px;  
        color: white;  
        font-size: 13px;  
    }  
  
    .remember input {  
        margin-right: 5px;  
    }  
  
    /* Bottom */  
    .login-bottom {  
        display: flex;  
        justify-content: space-between;  
        align-items: center;  
    }  
  
    .login-bottom a {  
        color: white;  
        font-size: 12px;  
        text-decoration: none;  
    }  
  
    .login-bottom a:hover {  
        text-decoration: underline;  
    }  
  
    /* Button */  
    .login-bottom button {  
        width: 110px;  
        height: 40px;  
        border: none;  
        border-radius: 7px;  
        background: linear-gradient(  
            90deg,  
            #667eea,  
            #3d258f  
        );  
        color: white;  
        font-size: 13px;  
        font-weight: 500;  
        cursor: pointer;  
        transition: 0.3s;  
    }  
  
    .login-bottom button:hover {  
        transform: translateY(-2px);  
        box-shadow:  
            0 8px 20px rgba(40, 20, 120, 0.4);  
    }  
  
    /* Mobile */  
    @media (max-width: 768px) {  
  
        .login-page {  
            min-height: calc(100vh - 60px); 
            justify-content: center;  
            padding: 50px 20px;  
            
            /* Full image show on mobile also */
            background-size: 100% 100%; 
            background-position: center center;  
        }  
  
        .login-card {  
            width: 100%;  
            max-width: 390px;  
        }  
    }  
</style>  
  
<div class="login-page">  
  
    <div class="login-card">  
  
        <h1>WELCOME!</h1>  
  
        <h2>user login</h2>  
  
        <form  
            action="/login"  
            method="POST"  
            class="needs-validation"  
            novalidate  
        >  
  
            <!-- Username -->  
            <div class="login-input">  
                <span>👤</span>  
  
                <input  
                    type="text"  
                    name="username"  
                    id="username"  
                    placeholder="user name"  
                    required  
                >  
            </div>  
  
            <!-- Password -->  
            <div class="login-input">  
                <span>🔒</span>  
  
                <input  
                    type="password"  
                    name="password"  
                    id="password"  
                    placeholder="password"  
                    required  
                >  
            </div>  
  
            <!-- Remember Me -->  
            <div class="remember">  
                <label>  
                    <input type="checkbox">  
                    remember me  
                </label>  
            </div>  
  
            <!-- Bottom -->  
            <div class="login-bottom">  
  
                <a href="/signup">  
                    I haven't got an account  
                </a>  
  
                <button type="submit">  
                    let's go! →  
                </button>  
  
            </div>  
  
        </form>  
  
    </div>  
  
</div>