<style>

/* =========================================================
   ULTRA PREMIUM WANDERLUST NAVBAR
   ========================================================= */

.navbar {
    min-height: 5rem;

    position: sticky !important;
    top: 0 !important;
    z-index: 9999 !important;

    background: rgba(255, 255, 255, 0.94) !important;

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(0, 0, 0, 0.07) !important;

    box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.03),
        0 8px 30px rgba(0, 0, 0, 0.06);

    transition:
        box-shadow 0.3s ease,
        background 0.3s ease;
}


/* =========================================================
   NAVBAR CONTAINER
   ========================================================= */

.navbar .container-fluid {
    min-height: 5rem;
    padding-left: 28px;
    padding-right: 28px;
}


/* =========================================================
   WANDERLUST LOGO
   ========================================================= */

.navbar-brand {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-right: 18px;

    border-radius: 15px;
    text-decoration: none;

    transition:
        background 0.25s ease,
        transform 0.25s ease;
}

.navbar-brand:hover {
    background: #fff1f2;
    transform: translateY(-1px);
}

.navbar-brand .fa-compass {
    color: #fe424d;
    font-size: 2.15rem;

    filter:
        drop-shadow(
            0 4px 8px
            rgba(254, 66, 77, 0.18)
        );

    transition:
        transform 0.35s ease;
}

.navbar-brand:hover .fa-compass {
    transform:
        rotate(-15deg)
        scale(1.08);
}


/* =========================================================
   NAVIGATION LINKS
   ========================================================= */

.navbar .nav-link {
    position: relative;

    color: #222222 !important;

    font-size: 14px;
    font-weight: 500;

    padding: 10px 14px !important;
    margin: 0 2px;

    border-radius: 12px;
    white-space: nowrap;

    transition:
        color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease;
}


/* Hover */

.navbar .nav-link:hover {
    color: #fe424d !important;
    background: #fff6f6;
    transform: translateY(-1px);
}


/* =========================================================
   PREMIUM LINK UNDERLINE
   ========================================================= */

.navbar .nav-link::after {
    content: "";

    position: absolute;

    left: 14px;
    right: 14px;
    bottom: 4px;

    height: 2px;

    border-radius: 10px;

    background: #fe424d;

    transform: scaleX(0);
    transform-origin: center;

    transition:
        transform 0.25s ease;
}

.navbar .nav-link:hover::after {
    transform: scaleX(1);
}


/* =========================================================
   SEARCH FORM
   ========================================================= */

.search-form {
    margin-right: 20px;
    margin-bottom: 0;
}


/* =========================================================
   PREMIUM SEARCH CONTAINER
   ========================================================= */

.search-container {
    width: 370px;
    height: 50px;

    display: flex;
    align-items: center;

    background: rgba(255, 255, 255, 0.98);

    border: 1px solid #e5e5e5;
    border-radius: 30px;

    padding: 4px;

    box-sizing: border-box;

    box-shadow:
        0 3px 10px rgba(0, 0, 0, 0.05),
        0 8px 25px rgba(0, 0, 0, 0.04);

    transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
}


/* Search Hover */

.search-container:hover {
    border-color: #d6d6d6;

    box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.07),
        0 12px 30px rgba(0, 0, 0, 0.06);

    transform: translateY(-1px);
}


/* Search Focus */

.search-container:focus-within {
    border-color: #ff416c;

    box-shadow:
        0 5px 18px rgba(255, 65, 108, 0.10),
        0 12px 32px rgba(255, 65, 108, 0.12);
}


/* =========================================================
   SEARCH ICON
   ========================================================= */

.search-icon {
    width: 20px;

    margin-left: 15px;
    margin-right: 8px;

    color: #777777;
    font-size: 14px;

    transition:
        color 0.25s ease,
        transform 0.25s ease;
}

.search-container:focus-within .search-icon {
    color: #ff416c;
    transform: scale(1.08);
}


/* =========================================================
   SEARCH INPUT
   ========================================================= */

.search-input {
    flex: 1;

    height: 40px;
    min-width: 0;

    padding: 0 5px;

    border: none !important;
    outline: none !important;
    box-shadow: none !important;

    background: transparent !important;

    color: #222222;

    font-size: 14px;
    font-weight: 400;
}

.search-input::placeholder {
    color: #999999;

    transition:
        color 0.2s ease;
}

.search-container:focus-within .search-input::placeholder {
    color: #b5b5b5;
}


/* =========================================================
   PREMIUM SEARCH BUTTON
   ========================================================= */

.btn-search {
    height: 42px;

    padding: 0 23px;

    border: none !important;
    border-radius: 24px;

    background:
        linear-gradient(
            135deg,
            #ff416c,
            #ff4b2b
        ) !important;

    color: #ffffff !important;

    font-size: 13px;
    font-weight: 600;

    letter-spacing: 0.2px;

    box-shadow:
        0 4px 12px rgba(255, 65, 108, 0.22);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
}


/* Search Button Hover */

.btn-search:hover {
    color: #ffffff !important;

    background:
        linear-gradient(
            135deg,
            #ff4b2b,
            #ff416c
        ) !important;

    filter: brightness(0.97);

    transform:
        translateY(-1px)
        scale(1.02);

    box-shadow:
        0 7px 17px rgba(255, 65, 108, 0.30);
}


/* Search Button Active */

.btn-search:active {
    transform: scale(0.96);
}


/* =========================================================
   WANDERLUST YOUR HOME
   ========================================================= */

.navbar .nav-link[href="/listings/new"] {
    font-weight: 600;
    color: #333333 !important;
}

.navbar .nav-link[href="/listings/new"]:hover {
    color: #ff416c !important;
}


/* =========================================================
   SIGN UP
   ========================================================= */

.navbar .nav-link[href="/signup"] {
    font-weight: 600;
}


/* =========================================================
   LOGIN PREMIUM BUTTON
   ========================================================= */

.navbar .nav-link[href="/login"] {
    padding: 9px 19px !important;

    margin-left: 5px;

    border-radius: 24px;

    background:
        linear-gradient(
            135deg,
            #ff416c,
            #ff4b2b
        );

    color: #ffffff !important;

    font-weight: 600;

    box-shadow:
        0 5px 14px
        rgba(255, 65, 108, 0.20);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}


/* Login Hover */

.navbar .nav-link[href="/login"]:hover {
    color: #ffffff !important;

    background: linear-gradient(
        135deg,
        #2575fc,
        #6a11cb
    ) !important;

    transform: translateY(-2px);

    box-shadow:
        0 8px 20px rgba(37, 117, 252, 0.35);
}


/* Login button ke neeche line nahi */

.navbar .nav-link[href="/login"]::after {
    display: none;
}


/* =========================================================
   MY BOOKINGS
   ========================================================= */

.navbar .nav-link[href="/listings/my-bookings"] {
    font-weight: 600;
}


/* =========================================================
   LOGOUT
   ========================================================= */

.navbar .nav-link[href="/logout"] {
    color: #555555 !important;
}

.navbar .nav-link[href="/logout"]:hover {
    color: #ff416c !important;
}


/* =========================================================
   MOBILE TOGGLER
   ========================================================= */

.navbar-toggler {
    width: 44px;
    height: 42px;

    padding: 8px;

    border: 1px solid #dddddd !important;
    border-radius: 12px;

    background: #ffffff;

    box-shadow:
        0 3px 10px rgba(0, 0, 0, 0.05) !important;

    transition:
        background 0.2s ease,
        border-color 0.2s ease;
}

.navbar-toggler:hover {
    background: #fff5f5;
    border-color: #ff416c !important;
}

.navbar-toggler:focus {
    box-shadow:
        0 0 0 3px
        rgba(255, 65, 108, 0.10) !important;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1150px) {

    .navbar .container-fluid {
        padding-left: 20px;
        padding-right: 20px;
    }

    .search-container {
        width: 310px;
    }

    .navbar .nav-link {
        padding-left: 9px !important;
        padding-right: 9px !important;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 768px) {

    .navbar {
        min-height: 4.5rem;
    }

    .navbar .container-fluid {
        min-height: 4.5rem;

        padding-left: 15px;
        padding-right: 15px;
    }

    .navbar-brand {
        width: 44px;
        height: 44px;

        margin-right: 8px;
    }

    .navbar-brand .fa-compass {
        font-size: 1.95rem;
    }


    /* =====================================================
       MOBILE COLLAPSE
       ===================================================== */

    .navbar-collapse {
        margin-top: 12px;

        padding: 14px;

        background:
            rgba(255, 255, 255, 0.98);

        border: 1px solid #eeeeee;

        border-radius: 18px;

        box-shadow:
            0 10px 30px
            rgba(0, 0, 0, 0.09);
    }


    /* =====================================================
       MOBILE LINKS
       ===================================================== */

    .navbar .nav-link {
        width: 100%;

        padding: 11px 13px !important;

        margin: 2px 0;

        border-radius: 11px;
    }


    /* =====================================================
       MOBILE SEARCH
       ===================================================== */

    .search-form {
        width: 100%;

        margin: 10px 0 15px;
    }

    .search-container {
        width: 100%;
        height: 48px;
    }

    .search-icon {
        margin-left: 13px;
    }

    .btn-search {
        height: 40px;

        padding: 0 17px;

        font-size: 12px;
    }


    /* =====================================================
       MOBILE RIGHT NAV
       ===================================================== */

    .navbar .navbar-nav:last-child {
        width: 100%;
        align-items: stretch;
    }


    /* Login */

    .navbar .nav-link[href="/login"] {
        width: 100%;

        margin: 5px 0 0;

        text-align: center;
    }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

    .navbar .container-fluid {
        padding-left: 10px;
        padding-right: 10px;
    }

    .navbar-brand {
        width: 42px;
        height: 42px;
    }

    .navbar-brand .fa-compass {
        font-size: 1.8rem;
    }

    .search-input {
        font-size: 13px;
    }

    .search-input::placeholder {
        font-size: 12px;
    }

    .btn-search {
        padding: 0 14px;
        font-size: 11px;
    }
}

</style>


<!-- =========================================================
     PREMIUM NAVBAR
     ========================================================= -->

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

    <div class="container-fluid">


        <!-- ================= LOGO ================= -->

        <a class="navbar-brand" href="/listings">

            <i class="fa-solid fa-compass"></i>

        </a>


        <!-- ================= MOBILE TOGGLER ================= -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- ================= NAVBAR COLLAPSE ================= -->

        <div
            class="collapse navbar-collapse"
            id="navbarNavAltMarkup">


            <!-- ================= EXPLORE ================= -->

            <div class="navbar-nav">

                <a
                    class="nav-link"
                    href="/listings">

                    Explore

                </a>

            </div>


            <!-- ================= SEARCH ================= -->

            <div class="navbar-nav ms-auto">

                <form
                    class="d-flex search-form"
                    action="/listings"
                    method="GET"
                    role="search">


                    <div class="search-container">


                        <i
                            class="fa-solid fa-magnifying-glass search-icon">
                        </i>


                        <input
                            class="form-control search-input"
                            type="search"
                            name="search"
                            placeholder="Search destinations..."
                            aria-label="Search"
                        />


                        <button
                            class="btn btn-search"
                            type="submit">

                            Search

                        </button>


                    </div>

                </form>

            </div>


            <!-- ================= RIGHT SIDE ================= -->

            <div class="navbar-nav ms-auto">


                <!--
                yaha pe ye try kar rhe hai ke user aarge log in hai
                usko login na dekhe

                user aage signup kar chuke hai to signup na dekhe

                user aagar logout kar diya to logout na dekhe
                -->


                <!-- Wanderlust Your Home -->

                <a
                    class="nav-link"
                    href="/listings/new">

                    Wanderlust your home

                </a>


                <% if(!currUser){ %>


                    <!-- Sign Up -->

                    <a
                        class="nav-link"
                        href="/signup">

                        <b>Sign-up</b>

                    </a>


                    <!-- Login -->

                    <a
                        class="nav-link"
                        href="/login">

                        <b>Log-in</b>

                    </a>


                <% } %>


                <% if(currUser){ %>


                    <!-- ================= MY BOOKINGS ================= -->

                    <a
                        class="nav-link"
                        href="/listings/my-bookings">

                        My Bookings

                    </a>


                    <!-- ================= LOGOUT ================= -->

                    <a
                        class="nav-link"
                        href="/logout">

                        Log-out

                    </a>


                <% } %>


            </div>


        </div>

    </div>

</nav>