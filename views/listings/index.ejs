<% layout("/layouts/boilerplate") %> 

<link rel="stylesheet" href="/css/index.css"> 
 
<div class="container wanderlust-page"> 
 
 
    <!-- ================================= 
         CATEGORY BAR 
    ================================= --> 
 
    <div class="category-wrapper"> 
 
        <div id="filters"> 
 
 
            <div class="filters" data-category="Trending"> 
 
                <i class="fa-solid fa-fire"></i> 
 
                <p>Trending</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Rooms"> 
 
                <i class="fa-solid fa-bed"></i> 
 
                <p>Rooms</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Iconic Cities"> 
 
                <i class="fa-solid fa-city"></i> 
 
                <p>Iconic Cities</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Castles"> 
 
                <i class="fa-brands fa-fort-awesome"></i> 
 
                <p>Castles</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Amazing Pools"> 
 
                <i class="fa-solid fa-person-swimming"></i> 
 
                <p>Amazing Pools</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Camping"> 
 
                <i class="fa-solid fa-tent"></i> 
 
                <p>Camping</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Farms"> 
 
                <i class="fa-solid fa-cow"></i> 
 
                <p>Farms</p> 
 
            </div> 
 
 
            <div class="filters" data-category="Arctic"> 
 
                <i class="fa-solid fa-snowflake"></i> 
 
                <p>Arctic</p> 
 
            </div> 
 
 
            <!-- TAX --> 
 
            <div class="tax-toggle"> 
 
                <div class="form-check form-switch"> 
 
                    <input 
                        class="form-check-input" 
                        type="checkbox" 
                        role="switch" 
                        id="switchCheckDefault" 
                    > 
 
                    <label 
                        class="form-check-label" 
                        for="switchCheckDefault" 
                    > 
                        Display total after taxes 
                    </label> 
 
                </div> 
 
            </div> 
 
        </div> 
 
    </div> 
 
 
<!-- ================================= 
     LOCATION WISE LISTINGS 
================================= --> 
 
<% for(let location in listingsByLocation){ %> 
 
    <div class="location-section"> 
 
        <!-- LOCATION HEADING --> 
 
        <div class="location-heading"> 
 
            <h2> 
                Explore stays in 
                <%= listingsByLocation[location].name %> 
            </h2> 
 
            <span class="location-arrow"> 
                → 
            </span> 
 
            <!-- SCROLL ARROWS --> 
 
            <div class="location-scroll-arrows"> 
 
                <button 
                    class="scroll-btn scroll-left" 
                    type="button" 
                    aria-label="Scroll left" 
                > 
                    <i class="fa-solid fa-chevron-left"></i> 
                </button> 
 
                <button 
                    class="scroll-btn scroll-right" 
                    type="button" 
                    aria-label="Scroll right" 
                > 
                    <i class="fa-solid fa-chevron-right"></i> 
                </button> 
 
            </div> 
 
        </div> 
 
 
        <!-- LOCATION LISTINGS --> 
 
        <div class="scroll-container"> 
 
            <div class="listing-scroll"> 
 
                <% for(let listing of listingsByLocation[location].listings){ %> 
 
                    <a 
                        href="/listings/<%= listing._id %>" 
                        class="listing-link" 
                    > 
 
                        <div class="card listing-card"> 
 
                            <!-- IMAGE --> 
 
                            <div class="image-box"> 
 
                                <img 
                                    src="<%= listing.image.url %>" 
                                    alt="<%= listing.title %>" 
                                > 
 
                                <!-- POPULAR BADGE --> 
 
                                <div class="popular-badge"> 
                                    Guest favourite 
                                </div> 
 
 
                                <!-- HEART --> 
 
                                <div class="heart-button"> 
 
                                    <i class="fa-regular fa-heart"></i> 
 
                                </div> 
 
                            </div> 
 
 
                            <!-- CARD INFO --> 
 
                            <div class="listing-info"> 
 
                                <div class="listing-heading"> 
 
                                    <!-- TITLE --> 
 
                                    <div class="listing-title"> 
 
                                        <%= listing.title %> 
 
                                    </div> 
 
 
                                    <!-- RATING --> 
 
                                    <div class="rating"> 
 
                                        <% if(listing.averageRating){ %> 
 
                                            <i class="fa-solid fa-star"></i> 
 
                                            <%= listing.averageRating %> 
 
                                        <% } else { %> 
 
                                            <span style="color:#888;"> 
                                                New 
                                            </span> 
 
                                        <% } %> 
 
                                    </div> 
 
                                </div> 
 
 
                                <!-- LOCATION --> 
 
                                <div class="listing-location"> 
 
                                    <%= listing.location %>, 
                                    <%= listing.country %> 
 
                                </div> 
 
 
                                <!-- PRICE --> 
 
                                <div class="price-line"> 
 
                                    <span 
                                        class="listing-price" 
                                        data-price="<%= listing.price %>" 
                                    > 
 
                                        ₹<%= listing.price.toLocaleString("en-IN") %> 
 
                                    </span> 
 
 
                                    <span class="night"> 
                                        / night 
                                    </span> 
 
 
                                    <i class="tax-info"> 
 
                                        &nbsp; discount 18% GST 
 
                                    </i> 
 
                                </div> 
 
                            </div> 
 
                        </div> 
 
                    </a> 
 
                <% } %> 
 
            </div> 
 
        </div> 
 
    </div> 
 
<% } %> 
 
 
<!-- ================================= 
     TAX JAVASCRIPT 
================================= --> 
 
<script> 
 
    let taxSwitch = 
        document.getElementById("switchCheckDefault"); 
 
 
    if (taxSwitch) { 
 
        taxSwitch.addEventListener("click", () => { 
 
 
            let taxInfo = 
                document.getElementsByClassName("tax-info"); 
 
 
            let prices = 
                document.getElementsByClassName("listing-price"); 
 
 
            for (let info of taxInfo) { 
 
                info.style.display = 
                    taxSwitch.checked 
                        ? "inline" 
                        : "none"; 
 
            } 
 
 
            for (let price of prices) { 
 
                let originalPrice = 
                    Number(price.dataset.price); 
 
 
                if (taxSwitch.checked) { 
 
                    // 18% tax remove karne ke liye 
 
                    let totalPrice = 
                        originalPrice / 1.18; 
 
 
                    price.innerText = 
                        "₹" + 
                        Math.round(totalPrice) 
                            .toLocaleString("en-IN"); 
 
 
                } else { 
 
                    price.innerText = 
                        "₹" + 
                        originalPrice 
                            .toLocaleString("en-IN"); 
 
                } 
 
            } 
 
        }); 
 
    } 
 
</script> 
 
 
<!-- ================================= 
     CATEGORY FILTER 
================================= --> 
 
<script> 
 
    let filters = 
        document.getElementsByClassName("filters"); 
 
 
    for (let filter of filters) { 
 
        filter.addEventListener("click", () => { 
 
 
            let category = 
                filter.dataset.category; 
 
 
            window.location.href = 
                `/listings?category=${encodeURIComponent(category)}`; 
 
        }); 
 
    } 
 
</script> 
 
 
<!-- ================================= 
     LISTING SCROLL ARROWS 
================================= --> 
 
<script> 
 
    document 
        .querySelectorAll(".location-section") 
        .forEach(section => { 
 
 
            let scrollBox = 
                section.querySelector(".listing-scroll"); 
 
 
            let leftBtn = 
                section.querySelector(".scroll-left"); 
 
 
            let rightBtn = 
                section.querySelector(".scroll-right"); 
 
 
            leftBtn.addEventListener("click", () => { 
 
                scrollBox.scrollBy({ 
 
                    left: -500, 
 
                    behavior: "smooth" 
 
                }); 
 
            }); 
 
 
            rightBtn.addEventListener("click", () => { 
 
                scrollBox.scrollBy({ 
 
                    left: 500, 
 
                    behavior: "smooth" 
 
                }); 
 
            }); 
 
        }); 
 
</script>