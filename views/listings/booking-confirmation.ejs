<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-8 offset-2">

        <div class="card p-4 text-center">

            <h2>Booking Confirmed! 🎉</h2>

            <hr>

            <h4><%= listing.title %></h4>

            <p>
                <b>Location:</b>
                <%= listing.location %>, <%= listing.country %>
            </p>

            <p>
                <b>Check-in:</b>
                <%= booking.checkIn.toDateString() %>
            </p>

            <p>
                <b>Check-out:</b>
                <%= booking.checkOut.toDateString() %>
            </p>

            <p>
                <b>Guests:</b>
                <%= booking.guests %>
            </p>

            <h4>
                Total Price:
                &#x20B9; <%= booking.totalPrice.toLocaleString("en-IN") %>
            </h4>

            <hr>

            <a href="/listings" class="btn btn-dark">
                Back to Listings
            </a>

        </div>

    </div>

</div>